; Source2 world server example config.
; Copy this file outside source control and replace the database credentials.

[world]
address = 0.0.0.0
port = 9101
; Address sent to login clients in the world list. Do not leave this as
; 0.0.0.0 for a real server.
advertised_address = 127.0.0.1
name = Source2 World
; These must match a row in the login database login_worldservers table.
account = change-me
password = change-me
; server_version must be allowed by the login database login_versions table,
; or login_versions must contain the legacy wildcard '*'.
protocol_version = 0.5.0
server_version = source2
database_version = 0
; 2006 clients use the packed VeType application message-id prefix.
opcode_width = packed

[login]
remote_address = 127.0.0.1
remote_port = 9100

[world_db]
host = 127.0.0.1
port = 3306
name = eq2emu
user = eq2emu
password = change-me
tls = false

[logging]
level = info
console = true
